# UC2-用户注册用例图

flowchart LR
    actor "用户" as User
    rectangle "注册模块" as Reg {
        card "输入账号" as C1
        card "输入密码" as C2
        card "确认密码" as C3
        card "输入邮箱" as C4
        card "点击注册" as C5
        card "格式验证" as C6
        card "检查重复" as C7
        card "创建记录" as C8
        card "跳转登录" as C9
    }

    User --> C1
    C1 --> C2
    C2 --> C3
    C3 --> C4
    C4 --> C5
    C5 --> C6
    C6 -->|失败| C1
    C6 -->|成功| C7
    C7 -->|已存在| C1
    C7 -->|可用| C8
    C8 --> C9