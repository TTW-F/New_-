# UC5-查看历史用例图

flowchart LR
    actor "用户" as User
    rectangle "历史模块" as History {
        card "点击历史" as C1
        card "加载列表" as C2
        card "选择会话" as C3
        card "请求数据" as C4
        card "返回消息" as C5
        card "渲染列表" as C6
    }

    User --> C1
    C1 --> C2
    C2 --> C3
    C3 --> C4
    C4 --> C5
    C5 --> C6